#!/usr/bin/env bash

keys_to_add=$(
	cat ~/.ssh-keys.list |
	while read key; do
		fingerprint=$(ssh-keygen -lf $key  | awk "{print \$2}")
		if ! ssh-add -l | grep -q "$fingerprint"; then
			echo "$key"
		fi
	done
)

key_count=$(echo -n "$keys_to_add" | wc -l)
if [ -z "$keys_to_add" ]; then
	echo "No keys to add"
	exit 0
fi

echo "Keys to add ($key_count): $keys_to_add"
# Environment variable set to force to use terminal instead of trying X program
echo "$keys_to_add" | xargs env SSH_ASKPASS_REQUIRE=never ssh-add
